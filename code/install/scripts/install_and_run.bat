@echo off
REM =====================================================================
REM  LabSecAutomation 首次运行引导：先安装环境，装好立刻启动程序
REM ---------------------------------------------------------------------
REM  谁来调用？
REM    项目根目录的「启动程序.exe」在发现运行环境还没装好（或已损坏）时，
REM    会在项目自带的便携终端里执行本脚本 —— 用户只需要双击那一个 exe。
REM    手动双击本文件效果完全一样。
REM
REM  为什么要有这个中间脚本？
REM    要让「安装」和「启动程序」在同一个终端窗口里连续跑完。
REM    如果让启动器分别调用两次，会出现两个窗口来回闪，体验很差；
REM    而且还要处理"安装失败就不该继续启动"的判断，放在这里最省事。
REM
REM  编码为 GBK(936) + CRLF，不要另存为 UTF-8，否则 cmd 会解析出错。
REM =====================================================================

setlocal
chcp 936 >nul 2>&1

REM 本文件位于 <代码目录>\install\scripts\，所以代码目录是上两级
cd /d "%~dp0..\.."
set "CODE_DIR=%CD%"

REM 告诉安装脚本中途不要暂停（装完要接着启动程序，不该停下来等按键）
set "LABSEC_NO_PAUSE=1"

echo.
echo =====================================================
echo   LabSecAutomation  首次运行
echo =====================================================
echo.
echo   代码目录: %CODE_DIR%
echo.
echo   接下来会自动完成两件事:
echo     1. 安装运行环境（约 1~2 分钟，全程离线，不需要管理员权限）
echo     2. 启动程序
echo.

call "%~dp0install.bat"
set "RC=%ERRORLEVEL%"

if not "%RC%"=="0" (
    echo.
    echo =====================================================
    echo   安装没有成功，已中止
    echo =====================================================
    echo.
    echo   上面有具体的错误原因，请按提示处理之后，
    echo   重新双击项目根目录的「启动程序.exe」。
    echo.
    pause
    exit /b %RC%
)

echo.
echo [信息] 安装完成，正在启动程序...
echo.

REM run.bat 内部会自己做完整的环境与资源文件检查，并给出友好提示
call "%CODE_DIR%\run.bat"
set "RC=%ERRORLEVEL%"

REM 环境变量 LABSEC_NO_PAUSE 会一路传下去，但 run.bat 末尾的 pause 是无条件的
REM （程序跑完需要保留窗口给用户看结果），所以这里不需要额外处理。

exit /b %RC%
